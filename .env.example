# ---- Backend only (holds the Feishu credentials; never ship these in a CLI) ----
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=replace_with_app_secret
# Must match a redirect URI registered in the Feishu developer console and point
# at THIS backend's /auth/callback. Local dev uses loopback; production uses a
# public HTTPS URL.
FEISHU_REDIRECT_URI=http://127.0.0.1:8787/auth/callback
# Port the backend listens on (optional, defaults to 8787).
PORT=8787

# ---- CLI only (where the CLI finds the backend) ----
DOUBAO_LOGIN_DEMO_BACKEND_URL=http://127.0.0.1:8787
